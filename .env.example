# =============================================================================
# Variables de entorno del microservicio de restaurantes (plazoleta-restaurantes)
# Copia este archivo como .env en la raíz del proyecto:  Copy-Item .env.example .env
# El archivo .env no se sube a git.
# =============================================================================

# --- Seguridad compartida con plazoleta-usuarios (deben ser IGUALES en ambos) ---
# Clave HS256 para validar el JWT que emite el servicio de usuarios (mínimo 32 caracteres)
APP_JWT_SECRET=plazoleta-local-dev-secret-key-change-me-32-chars-min
# Token para las rutas /internal/** entre microservicios
USERS_INTERNAL_TOKEN=plazoleta-internal-token-change-me

# --- Base de datos MySQL (creada por db/mysql-init.sql) ---
DB_URL=jdbc:mysql://localhost:3306/plazoleta?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=plazoleta_user
DB_PASSWORD=plazoleta_pass

# --- Servicio de usuarios (HU-2 valida que el dueño tenga rol PROPIETARIO) ---
USERS_SERVICE_BASE_URL=http://localhost:8081
